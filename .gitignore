# =============================================================================
# EvidenceGraph — .gitignore
# =============================================================================

# Secrets — NEVER commit these
.env
.env.local
.env.*.local

# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
dist/
build/
*.egg
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Node / Frontend
node_modules/
dist/
dist-ssr/
*.local
.next/
out/

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE / AI tooling — personal, not project
.vscode/
.idea/
*.iml
.kiro/
.freebuff/
opencode.json

# Local webhook tunnels (download on demand, never commit the binaries)
cloudflared
cloudflared.exe
ngrok
ngrok.exe
ngrok.zip
*.ngrok.yml

# Alembic
# (keep alembic/versions tracked, but ignore pycache inside)
backend/alembic/versions/__pycache__/

# Logs
*.log
logs/
