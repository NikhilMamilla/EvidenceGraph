# =============================================================================
# EvidenceGraph — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_NAME=evidencegraph-api
BACKEND_PORT=8000
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
#
# This project uses the Supabase SESSION POOLER (IPv4 compatible).
#
# Get your connection string from:
#   Supabase Dashboard → Project Settings → Database → Session pooler → URI
#
# Format:
#   postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# IMPORTANT: URL-encode special characters in your password:
#   @ → %40    # → %23    % → %25
#
# SSL: sslmode=require is mandatory. Supabase enforces SSL.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require

# -----------------------------------------------------------------------------
# Cache — Redis (local Docker)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Logging
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Razorpay — OPTIONAL (not required until Phase 2+)
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# AI semantic layer — OPTIONAL (Phase 22/23 defense verifier)
#
# When AI_ENABLED is false (default) the verifier uses the deterministic
# TestAIProvider — no network, no key, fully reproducible. Turn this on only
# for the real three-way evaluation (deterministic vs test-AI vs real-LLM).
#
#   AI_PROVIDER=anthropic  -> native Claude SDK, reads ANTHROPIC_API_KEY
#   AI_PROVIDER=openai      -> OpenAI-compatible API (OpenAI / OpenRouter / Groq / local)
#   AI_PROVIDER=test        -> deterministic stub (default)
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=test

# --- Anthropic (AI_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-opus-5        # claude-haiku-4-5 / claude-sonnet-5 are cheaper for bulk eval runs

# --- OpenAI-compatible (AI_PROVIDER=openai) ---
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Shared tuning ---
AI_TIMEOUT_SECONDS=30
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.0
